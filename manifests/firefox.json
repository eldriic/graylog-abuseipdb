{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "graylog-abuseipdb@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "https://api.abuseipdb.com/*",
    "https://ipwho.is/*"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "shared/api.js",
      "shared/ip.js",
      "shared/settings.js",
      "shared/sites.js",
      "background/background.js"
    ]
  },
  "browser_action": {
    "default_title": "AbuseIPDB Lookup",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
